generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model StravaAccount {
  id           String    @id @default(cuid())
  athleteId    String    @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scopes       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@map("strava_accounts")
}

model Session {
  id              String        @id
  stravaAccountId String
  account         StravaAccount @relation(fields: [stravaAccountId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([stravaAccountId])
  @@map("sessions")
}